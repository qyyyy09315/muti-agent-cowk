{
  "name": "ai-collab-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:monitor",
    "collab:doctor": "node scripts/doctor.mjs",
    "collab:check-update": "node scripts/check-update.mjs",
    "collab:monitor": "node scripts/worker-monitor/server.mjs",
    "test:monitor": "node --test scripts/worker-monitor/*.test.mjs"
  },
  "packageManager": "pnpm@10.27.0"
}
