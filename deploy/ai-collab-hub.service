[Unit]
Description=AI Collab Hub Control Plane
After=network.target postgresql.service

[Service]
Type=simple
User=collab
Group=collab
WorkingDirectory=/path/to/ai-collab/apps/hub
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOST=127.0.0.1
Environment=DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_collab
Environment=HUB_SESSION_SECRET=replace-with-your-secure-random-secret
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
